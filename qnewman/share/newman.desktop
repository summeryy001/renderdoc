[Desktop Entry]
Version=1.0
Name=NewMan
Comment=A stand-alone graphics API debugger
Comment[ru]=Автономный отладчик графических API
GenericName=Graphics Debugger
Exec=qnewman %f
Icon=application-x-newman-capture
Terminal=false
Type=Application
X-MultipleArgs=false
Categories=Development;
Keywords=NewMan;
Keywords[ru]=РендерДок;
StartupNotify=true
MimeType=application/x-newman-capture;
